{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.test.ts",
    "../functions/_shared/payments.ts",
    "../functions/_shared/cards.ts",
    "../functions/_shared/push.ts",
    "../functions/_shared/apns.ts"
  ]
}
