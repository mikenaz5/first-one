// Copy to Secrets.xcconfig (git-ignored) and fill in.
//
// xcconfig treats "//" as a comment, so the URL scheme separator is escaped
// with the empty-variable trick below.
//
// The anon key is a public, client-side key. Row Level Security is what
// protects the data. Never put the service_role key in this file.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Needed to run on a device or to enable Sign in with Apple on the simulator.
DEVELOPMENT_TEAM = YOURTEAMID
