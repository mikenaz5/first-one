// Copy to Secrets.xcconfig (git-ignored) and fill in.
//
// xcconfig treats "//" as a comment, so the URL scheme separator is escaped
// with the empty-variable trick below.
//
// The anon key is a public, client-side key. Row Level Security is what
// protects the data. Never put the service_role key in this file.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Needed to run on a device or to enable Sign in with Apple on the simulator.
DEVELOPMENT_TEAM = YOURTEAMID

// Real payments (optional; leave these out to use pretend payments on-device).
// 1. Create a merchant ID in your Apple developer account (Certificates, IDs & Profiles) and register Stripe's
//    Apple Pay certificate for it in the Stripe dashboard.
// 2. Use Stripe's publishable key (pk_test_… / pk_live_…). Never put the secret key (sk_…) in the app.
// 3. Switch to the entitlements file that includes Apple Pay.
STRIPE_PUBLISHABLE_KEY = pk_test_YOUR-KEY
APPLE_PAY_MERCHANT_ID = merchant.com.example.slate
CODE_SIGN_ENTITLEMENTS = Config/Slate.ApplePay.entitlements
